<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required by Apple for all AUv3 App Extensions -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <!-- Required for WKWebView's internal XPC round-trips to the host process
         when using a custom URL scheme handler (juce:// resource provider).
         Without this, the WebContent process cannot call back to the AUv3
         extension process to fetch index.html / bundle.js, resulting in a
         blank plugin window in Logic Pro and other AUv3 hosts. -->
    <key>com.apple.security.network.client</key>
    <true/>
</dict>
</plist>
