# Per-machine WebUI source override — copy to `webui.local.cmake` (gitignored).
#
# DrawnQurve's WebUI source lives in the music-suite monorepo (apps/drawnqurve),
# shared with the standalone webapp. CMake defaults to a sibling checkout:
#   ${CMAKE_SOURCE_DIR}/../music-suite/apps/drawnqurve
#
# If your music-suite checkout is elsewhere, point DRAWNQURVE_WEBUI_DIR at its
# apps/drawnqurve directory here. The monorepo must be `npm install`ed so esbuild
# and react resolve from its hoisted node_modules.
set(DRAWNQURVE_WEBUI_DIR "/path/to/music-suite/apps/drawnqurve" CACHE PATH "" FORCE)
